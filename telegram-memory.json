  "purpose": "Persistent CRICZONE Telegram assistant rules and provider directory. Edit this file to change bot behavior without repeating instructions.",
  "response_rules": {
    "match_query": "For any two teams and any separator (vs, v, versus, against), show provider names only.",
    "provider_query": "After provider selection, show each real channel name with its CRICZONE page URL.",
    "exact_sony": "Only exact 'sony' returns https://criczone.pages.dev/sony/. 'sony sports' must use the Sony Sports provider channel list.",
    "channel_selection": "When a user selects a channel, return only that channel name and its page URL.",
    "privacy": "Never expose upstream stream URLs, DRM keys, cookies, tokens, or credentials.",
    "quality": "Deduplicate channels, exclude unrelated broadcaster channels, tolerate minor spelling mistakes, and never invent a channel or ID.",
    "sony_primary": "Show the seven Sony Sports channel-ID entries in sony_channel_sets.primary first. Each item includes its exact name and URL.",
    "sony_backup": "Only if the user reports the primary Sony channel is not working, show the criczone1 alternate entries in sony_channel_sets.backup.",
    "willow_cricbuzz": "For direct Willow or Cricbuzz requests, reply only with https://criczone.pages.dev/criczonebuzz/. Willow provider/channel search may include curated Willow USA entries in folder e when the user asks for Willow channels.",
    "fancode_web": "For FanCode, use the five channel_entries directly from memory, do not query feeds. Return five exact names and URLs, then append FANCODE WEB primary https://criczone.pages.dev/fancodeweb/ and OLD FANCODE WEB backup https://criczone.pages.dev/criczonefancode/. Exact fancode web request returns both links with the new web first.",
    "sky_fox_tnt": "Sky provider must return only the 28 curated Sky Sports records from telegram-channels.json source manual_directory. Preserve each record's exact folder and ID URL. Deduplicate by folder+ID and normalized channel name; do not mix other feeds.",
    "tnt": "For TNT or TNT Sports requests, return only the four current TNT Sports channel_entries listed in this provider. Do not use legacy TNT records from any feed or directory.",
    "star_sports": "Return exactly the 24 primary Star Sports channels listed in provider.channel_keys. Exclude all criczone1 backup/event-specific records. Preserve exact CRICZONE URL and channel name.",
    "sky_sports": "For sky or sky sports, return the exact 28 channel_entries from memory. Do not search feeds or apply generic name matching. Preserve exact URL per item.",
    "fox": "For Fox or Fox HD link requests, return the curated Fox Sports entries in provider.channel_entries only, using their exact /e/?id= URLs. Do not mix legacy criczone1 Fox entries."
  },
