<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover">
  <meta name="referrer" content="no-referrer">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

  <title>Player</title>

  <!-- Plyr CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.css">

  <!-- HLS.js -->
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

  <!-- Plyr JS -->
  <script src="https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.polyfilled.js"></script>

  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    html,body{width:100%;height:100%;background:#111;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;color:#fff}

    /* Channel List Layout */
    #channel-list{
      position:fixed;
      inset:0;
      background:#111;
      z-index:9998;
      display:flex;
      flex-direction:column;
      padding:16px;
    }

    .header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding-bottom:12px;
      border-bottom:1px solid #222;
      margin-bottom:12px;
    }
    .header h1{
      font-size:16px;
      font-weight:600;
      color:#fff;
    }
    .header .count{
      color:#888;
      font-size:12px;
    }

    /* Simple Grid */
    #grid-wrapper{
      flex:1;
      overflow-y:auto;
    }
    #ch-grid{
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(140px,1fr));
      gap:10px;
    }

    .ch-card{
      background:#1a1a1a;
      border:1px solid #282828;
      border-radius:8px;
      padding:12px 8px;
      cursor:pointer;
      text-decoration:none;
      display:flex;
      flex-direction:column;
      align-items:center;
      text-align:center;
      gap:8px;
      min-height:100px;
      justify-content:center;
    }
    .ch-card:hover{
      background:#222;
      border-color:#444;
    }
    .ch-card .ch-logo{
      max-width:90px;
      max-height:40px;
      object-fit:contain;
    }
    .ch-card .ch-name{
      color:#ccc;
      font-size:11px;
      font-weight:500;
    }

    /* Player Container */
    #player-container{
      position:fixed;
      inset:0;
      background:#000;
      z-index:9997;
      display:none;
      align-items:center;
      justify-content:center;
    }
    #player-container video{
      width:100%;
      height:100%;
      object-fit:contain;
      background:#000;
    }
    .plyr{height:100%;width:100%;background:#000}

    /* Loading Overlay */
    #overlay{
      position:fixed;
      inset:0;
      background:#111;
      z-index:10000;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#888;
      font-size:13px;
    }
  </style>
</head>
<body>

<div id="overlay">
  <p id="loadMsg">Loading...</p>
</div>

<!-- Simple Channel List -->
<div id="channel-list">
  <div class="header">
    <h1>Channels</h1>
    <span class="count">0</span>
  </div>
  <div id="grid-wrapper">
    <div id="ch-grid"></div>
  </div>
</div>

<!-- Player Container -->
<div id="player-container">
  <video id="player" playsinline webkit-playsinline controls preload="metadata"></video>
</div>

<script>
(function(){
"use strict";

var M3U_URL = "https://sportlink-jtv.pages.dev/sony3.m3u";
var PROXY_BASE = "https://ily-7hy.pages.dev/api/proxy?u=";

var $overlay = document.getElementById("overlay");
var $loadMsg = document.getElementById("loadMsg");
var $list = document.getElementById("channel-list");
var $grid = document.getElementById("ch-grid");
var $playerContainer = document.getElementById("player-container");
var $video = document.getElementById("player");

var allChannels = [];
var currentPlayer = null;
var currentHls = null;

function getChId() { return new URLSearchParams(location.search).get("id") || ""; }

function proxyUrl(url){
  if(!url) return url;
  if(url.indexOf(PROXY_BASE) === 0) return url;
  return PROXY_BASE + encodeURIComponent(url);
}

function parseM3U(text){
  var channels = [];
  var lines = text.split(/\r?\n/);
  var current = null;

  for(var i=0; i<lines.length; i++){
    var line = lines[i].trim();
    if(!line) continue;

    if(line.indexOf("#EXTINF:") === 0){
      var info = line.substring(8);
      var commaIdx = info.indexOf(",");
      var rawName = commaIdx >= 0 ? info.substring(commaIdx+1).trim() : "Unknown";
      var cleanName = rawName.replace(/@\w+/gi, "").trim();

      var attrs = commaIdx >= 0 ? info.substring(0,commaIdx) : info;
      var id = "";
      var logo = "";
      var idMatch = attrs.match(/tvg-id="([^"]*)"/i);
      if(idMatch) id = idMatch[1];
      var logoMatch = attrs.match(/tvg-logo="([^"]*)"/i) || attrs.match(/logo="([^"]*)"/i);
      if(logoMatch) logo = logoMatch[1];

      var safeId = id || (cleanName.replace(/[^a-z0-9]+/gi,"_").toLowerCase() + "_" + channels.length);
      current = { id: safeId, name: cleanName, logo: logo, stream_url: "" };
    } else if(line.charAt(0) !== "#" && current){
      current.stream_url = line;
      channels.push(current);
      current = null;
    }
  }
  return channels;
}

async function loadData(){
  var r = await fetch(M3U_URL, {cache:"no-store"});
  if(!r.ok) throw new Error("HTTP " + r.status);
  var text = await r.text();
  return parseM3U(text).filter(function(c){ return c.stream_url; });
}

function renderChannels(channels){
  document.querySelector('.header .count').textContent = channels.length + ' channels';
  var f = document.createDocumentFragment();
  channels.forEach(function(ch){
    var a = document.createElement("a");
    a.className = "ch-card";
    a.href = "?id=" + encodeURIComponent(ch.id);

    var logoHtml = ch.logo ? '<img class="ch-logo" src="'+ch.logo+'" alt="'+ch.name+'" loading="lazy" onerror="this.style.display=\'none\'">' : '';
    a.innerHTML = logoHtml + '<span class="ch-name">'+ch.name+'</span>';
    f.appendChild(a);
  });
  $grid.innerHTML = '';
  $grid.appendChild(f);
}

function showPlayer(){
  $list.style.display = "none";
  $playerContainer.style.display = "flex";
}

function setupHLSPlayer(url){
  showPlayer();
  if(currentHls) { currentHls.destroy(); currentHls = null; }
  if(currentPlayer) { currentPlayer.destroy(); currentPlayer = null; }

  var playUrl = proxyUrl(url);
  var defaultOptions = {
    controls: ['play', 'progress', 'current-time', 'mute', 'volume', 'settings', 'fullscreen'],
    settings: ['quality'],
    autoplay: true,
    muted: false
  };

  if(Hls.isSupported() && /\.m3u8(\?|$)/i.test(url)) {
    // Highly optimized HLS settings for instant loading and zero lag
    var hls = new Hls({
      autoStartLoad: true,
      enableWorker: true,
      lowLatencyMode: true,
      liveSyncDurationCount: 3,
      liveMaxLatencyDurationCount: 10,
      maxLiveSyncPlaybackRate: 1.5,
      maxBufferLength: 30,
      maxMaxBufferLength: 60,
      manifestLoadingTimeOut: 10000,
      manifestLoadingMaxRetry: 4,
      fragLoadingTimeOut: 15000,
      fragLoadingMaxRetry: 4
    });
    
    currentHls = hls;
    hls.loadSource(playUrl);
    hls.attachMedia($video);

    hls.on(Hls.Events.MANIFEST_PARSED, function(_, data) {
      var qualities = data.levels.map(function(l) { return l.height; }).filter(Boolean).sort(function(a,b){ return b-a; });
      qualities = qualities.filter(function(v,i){ return qualities.indexOf(v) === i; });

      currentPlayer = new Plyr($video, Object.assign({}, defaultOptions, qualities.length ? {
        quality: {
          default: qualities[0],
          options: qualities,
          forced: true,
          onChange: function(q) {
            hls.levels.forEach(function(level, index) {
              if(level.height === q) hls.currentLevel = index;
            });
          }
        }
      } : {}));

      $video.play().catch(function(){});
      $overlay.style.display = "none";
    });

    hls.on(Hls.Events.ERROR, function(_, data) {
      if(data.fatal) {
        if(data.type === Hls.ErrorTypes.NETWORK_ERROR) {
          hls.startLoad();
        } else if(data.type === Hls.ErrorTypes.MEDIA_ERROR) {
          hls.recoverMediaError();
        } else {
          hls.destroy();
          setupHLSPlayer(url);
        }
      }
    });
  } else {
    $video.src = playUrl;
    currentPlayer = new Plyr($video, defaultOptions);
    $video.play().catch(function(){});
    $overlay.style.display = "none";
  }
}

async function main(){
  var id = getChId();
  try {
    allChannels = await loadData();
    renderChannels(allChannels);
    $overlay.style.display = "none";
    $list.style.display = "flex";

    if(id) {
      var ch = allChannels.find(function(c){ return c.id === id; });
      if(ch) setupHLSPlayer(ch.stream_url);
    }
  } catch(e) {
    $loadMsg.textContent = "Failed to load.";
  }
}

document.addEventListener("DOMContentLoaded", main);
})();
</script>

</body>
</html>
